# =============================================================================
# MovieDB — environment variables (copy to `.env`; never commit real values)
# =============================================================================
# This root file is read by `docker compose`. For `npm run dev` use the
# per-package files instead: backend/.env, montage/.env, admin/.env
# (see backend/.env.example, montage/.env.example, admin/.env.example).

# ── Backend only. SECRET. Never expose to a browser or put in a VITE_ variable. ──
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co
# service_role (or sb_secret_...) key: same page. Bypasses RLS; server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API directly.
# Not needed when the web containers proxy /api (the default Compose setup).
CORS_ORIGINS=

# ── Admin SPA (public values, compiled into the JavaScript bundle). ──
# Same project URL as above, plus the *anon/publishable* key — NOT the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Optional ──
# Host ports published by docker compose
MONTAGE_PORT=8080
ADMIN_PORT=8081
