# Copy to backend/.env. Real environment variables take precedence over this file.

# --- Required ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Server-side secret (service_role or sb_secret_...). Do NOT use the anon key and
# do NOT prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional (defaults shown) ----------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated allowed browser origins. Defaults to the local Vite dev servers
# outside production; empty in production (same-origin proxy needs none).
CORS_ORIGINS=http://localhost:5174,http://localhost:5175
# Abort database requests after this many ms
DB_TIMEOUT_MS=8000
RATE_LIMIT_PER_MINUTE=300
WRITE_RATE_LIMIT_PER_MINUTE=60
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=
LOG_LEVEL=debug

# Deprecated (still read, with a warning): VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, FRONTEND_URL
