# Copy to montage/.env (optional for local dev).

# Base URL of the API as seen by the BROWSER.
# Leave unset to use same-origin "/api": in development Vite proxies it to
# VITE_DEV_PROXY_TARGET, in Docker nginx proxies it to the backend container.
# Never put a Docker service name (e.g. http://backend:5000) here.
# VITE_API_URL=http://localhost:5000/api

# Dev only: where `vite` proxies /api (default http://localhost:5000)
# VITE_DEV_PROXY_TARGET=http://localhost:5000
