# Copy to admin/.env (optional for local dev, except the Supabase values).

# Base URL of the API as seen by the BROWSER (see montage/.env.example).
# VITE_API_URL=http://localhost:5000/api
# VITE_DEV_PROXY_TARGET=http://localhost:5000

# Admin sign-in uses Supabase Auth. These are PUBLIC values compiled into the bundle:
# the project URL and the anon/publishable key. Never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
